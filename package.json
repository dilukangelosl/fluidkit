{
  "name": "@dilukangelo/fluidkit",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Framework-agnostic GPU fluid simulation for the web. Decoupled sim engine and pluggable render modes.",
  "license": "MIT",
  "author": "Diluk Angelo <dilukangelo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dilukangelosl/fluidkit.git"
  },
  "keywords": [
    "webgl",
    "fluid",
    "simulation",
    "fluid-simulation",
    "navier-stokes",
    "creative-coding",
    "hero-background",
    "landing-page"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite demo",
    "build": "tsc -p tsconfig.json",
    "build:demo": "vite build demo",
    "test": "node --test test/api.test.ts",
    "prepublishOnly": "npm test && npm run build",
    "preview": "vite preview demo"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
